# ---------------------------------------------------------------------------
# Resume Forge — environment variables
#
# Copy this file to `.env.local` and fill in what you need.
# Everything in the app works with NO keys at all; the AI assistant is the only
# feature that requires one, and it stays disabled (with an honest explanation
# in the UI) until at least one provider key is present.
#
# Rule: keys are read on the server only. They are never sent to the browser,
# and /api/ai/status reports which providers are configured — not their values.
# ---------------------------------------------------------------------------

# --- Public ----------------------------------------------------------------
# Absolute origin used for canonical URLs, the sitemap and OG metadata.
# Leave unset in local development (defaults to http://localhost:3000).
NEXT_PUBLIC_SITE_URL=""

# Address shown on the contact page. The form composes a mailto: link, so this
# is only ever displayed, never called by a server.
NEXT_PUBLIC_CONTACT_EMAIL="hello@resumeforge.dev"

# --- AI providers ----------------------------------------------------------
# Provide any ONE of these to enable the assistant. More than one gives you
# automatic fallback: if the first provider fails or times out, the next in the
# order is tried. All are official, documented, key-based HTTP APIs.
#
# Free-tier wording is intentionally vague — quotas change. Check the linked
# docs before depending on a provider for volume.

# Google AI Studio (Gemini) — https://ai.google.dev/gemini-api/docs
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Groq — https://console.groq.com/docs/openai
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# OpenRouter — https://openrouter.ai/docs/api-reference/overview
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# Cerebras — https://inference-docs.cerebras.ai/api-reference/chat-completions
CEREBRAS_API_KEY=""
CEREBRAS_MODEL="llama3.3-70b"

# Hugging Face Inference Providers — https://huggingface.co/docs/inference-providers
HUGGINGFACE_API_KEY=""
HUGGINGFACE_MODEL="meta-llama/Llama-3.3-70B-Instruct"

# --- Optional behaviour ----------------------------------------------------
# Comma-separated provider priority. Unknown names are ignored.
# Default: gemini,groq,openrouter,cerebras,huggingface
AI_PROVIDER_ORDER=""

# Per-provider request timeouts and the retry policy are defined in
# lib/ai/providers/config.ts and lib/ai/orchestrator.ts (2 retries with backoff,
# 5-minute cooldown after a provider fails). Nothing else needs configuring.
